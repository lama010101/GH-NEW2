    "gs_01_title": "Create your account",
    "gs_01_desc": "Sign up with email or use a social login. Choose a display name and pick a historical figure as your avatar.",
    "gs_02_title": "Play a Practice round",
    "gs_02_desc": "Start with Practice mode to learn the ropes. No timer, unlimited retries—just explore and get comfortable.",
    "gs_03_title": "Try the Daily Challenge",
    "gs_03_desc": "Once ready, tackle the Daily Challenge. Same events as everyone else—see how you rank on the global leaderboard.",
    "gs_04_title": "Invite friends",
    "gs_04_desc": "Create a Compete lobby, copy the room code, and invite friends. Choose Rush for real-time action or Relax for turn-based play.",
    "step_observe": "Observe",
