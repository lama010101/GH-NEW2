#!/usr/bin/env bash
# MP-GUARD-SYNC-REGRESSION-001 — pre-push gate for sync compete path.
# Runs the golden-path Playwright spec ONLY when the push touches a
# protected file. Fails loudly if the dev stack is down — never a silent pass.

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Read protected file list (one glob per line) from the manifest
PROTECTED_FILE="scripts/dev/sync-compete-protected-files.txt"
if [ ! -f "$PROTECTED_FILE" ]; then
  echo "PRE-PUSH: protected-file manifest not found at $PROTECTED_FILE — skipping gate."
  exit 0
fi

# Keep the merge target current. A stale origin/main could let protected files
# already merged upstream appear as "changed" in this branch.
if ! git fetch --quiet origin main; then
  echo "PRE-PUSH: failed to fetch origin/main — cannot safely verify protected-file diff, aborting push"
  exit 1
fi
echo "PRE-PUSH: fetched origin/main"

# Determine the diff base: the actual merge target (origin/main). Compare
# HEAD against the branch's merge target, not the incremental push delta, so
# every push of a long-lived branch still sees protected files introduced in
# earlier pushes.
DIFF_BASE="origin/main"
echo "PRE-PUSH: comparing against $DIFF_BASE"

PUSHED_FILES=$(git diff --name-only "$DIFF_BASE"..HEAD 2>/dev/null)
if [ -z "$PUSHED_FILES" ]; then
  echo "PRE-PUSH: no pushed files to check — skipping golden-path gate."
  exit 0
fi

# Check if any pushed file matches any pattern in the manifest.
# One clean loop: for each pushed file, try each manifest pattern.
# Comment lines (# ...) and empty lines in the manifest are skipped.
TOUCHES_PROTECTED=0
OLD_IFS="$IFS"
set -f
IFS='
'
for f in $PUSHED_FILES; do
  [ -n "$f" ] || continue
  while IFS= read -r pattern; do
    # Skip empty lines and comments
    [ -z "$pattern" ] && continue
    case "$pattern" in \#*) continue ;; esac
    # shellcheck disable=SC2254
    case "$f" in
      $pattern) TOUCHES_PROTECTED=1; break ;;
    esac
  done < "$PROTECTED_FILE"
  if [ "$TOUCHES_PROTECTED" -ne 0 ]; then
    break
  fi
done
IFS="$OLD_IFS"
set +f

if [ "$TOUCHES_PROTECTED" -eq 0 ]; then
  echo "PRE-PUSH: no protected sync-compete files touched — skipping golden-path gate."
  exit 0
fi

echo "PRE-PUSH: protected sync-compete file touched — running golden-path spec."

# Loud-failure liveness check (dev server :3000 + partykit :1999)
bash scripts/dev/check-compete-stack.sh
STACK_EXIT=$?
if [ "$STACK_EXIT" -ne 0 ]; then
  echo "PRE-PUSH: FAILED — dev stack not running. Start with: npm run dev"
  echo "PRE-PUSH: The gate never silently passes. Fix the stack and re-push."
  exit 1
fi

# MP-FIX-GATE-COLDCOMPILE-WARMUP-001 — warm the /compete/[gameId] route
# BEFORE the timed Playwright run. A freshly started Next.js dev server
# takes ~24-29s to on-demand-compile the /compete/[gameId] route (1500+
# modules) on the first hit, which exceeds the spec's 30s domcontentloaded
# timeout (NAV_TIMEOUT in sync-compete-golden-path.spec.ts). Second+ hits
# are ~0.25s. This single GET to a throwaway gameId pays that one-time
# cold-compile tax outside the timed window. The response status is
# irrelevant — even an error/lobby page compiles the route — so only a
# connection failure (curl exit != 0) aborts the gate. No application
# code is touched; pure tooling/CI plumbing.
WARMUP_GAMEID="00000000-0000-0000-0000-000000000000"
WARMUP_URL="http://localhost:3000/compete/${WARMUP_GAMEID}"
echo "PRE-PUSH: warming route ${WARMUP_URL} (absorbs cold-compile cost before timed run)..."
WARMUP_HTTP=$(curl -s -o /dev/null --max-time 120 --write-out '%{http_code}' "${WARMUP_URL}" 2>/dev/null)
WARMUP_CURL_EXIT=$?
if [ "$WARMUP_CURL_EXIT" -ne 0 ]; then
  echo "PRE-PUSH: FAILED — route warm-up request failed (curl exit ${WARMUP_CURL_EXIT}). Dev server not reachable at ${WARMUP_URL}."
  echo "PRE-PUSH: The gate never silently passes. Fix the stack and re-push."
  exit 1
fi
echo "PRE-PUSH: route warm-up complete (HTTP ${WARMUP_HTTP}). Cold-compile cost absorbed; timed run may proceed."

# Run the golden-path spec: scripts/test/playwright/specs/sync-compete-golden-path.spec.ts
# (3-min timeout enforced by the sync-golden project config)
npx playwright test --config=scripts/test/playwright/playwright.config.ts \
  --project=sync-golden
SPEC_EXIT=$?

if [ "$SPEC_EXIT" -ne 0 ]; then
  echo "PRE-PUSH: FAILED — sync compete golden-path spec failed."
  echo "PRE-PUSH: See report: npx playwright show-report"
  echo "PRE-PUSH: To bypass (rescue only): git push --no-verify"
  echo "PRE-PUSH: Bypass does NOT replace the mandatory manual two-browser smoke test pre-deploy (KC-009)."
  exit 1
fi

echo "PRE-PUSH: sync compete golden-path passed."
exit 0
