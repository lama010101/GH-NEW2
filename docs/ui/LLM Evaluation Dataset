    "dataset_version": "...",
    "ground_truth_version": "...",
    "stimulus_id": "...",
    "parser_version": "..."
  },

  "submitted_answer": {
    "raw_answer": "...",
    "normalized_year_guess": null,
    "normalized_location_guess": null,
    "confidence_value": null,
    "confidence_scale": null
  },

  "execution": {
    "request_started_at": "...",
    "response_received_at": "...",
    "end_to_end_latency_ms": 0,
    "model_latency_ms": null,
    "input_tokens": null,
    "output_tokens": null,
    "reasoning_tokens": null,
