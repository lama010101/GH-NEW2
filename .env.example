# ============================================================
# GH-NEW2 — DEV / LOCAL defaults template
# These values are placeholders for LOCAL DEVELOPMENT only
# (Devin Cloud fresh clones, Devin Local, standalone script runs).
# They target the DEV Supabase project (gh-new2-dev) by default.
#
# PRODUCTION values live ONLY in the Vercel dashboard and are
# NEVER committed anywhere in this repo (not here, not in .dev.vars,
# not in any workflow file).
#
# Copy this file to .env.local and fill in real DEV credentials.
# The Devin blueprint populates .env.local from
# /run/repo_secrets/lama010101/GH-NEW2/.env.secrets for Devin Cloud
# sessions; this template covers non-blueprint local clones.
# ============================================================

# --- Supabase (DEV project: gh-new2-dev) ---
# Base URL — single source of truth for the dev project URL.
# Used by Next.js client + partykit dev server (see src/server/db.ts,
# partykit/server.ts).
SUPABASE_URL=https://<your-dev-project-ref>.supabase.co

# Derived public URL (framework compatibility). Keep in sync with
# SUPABASE_URL (or set NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}).
NEXT_PUBLIC_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co

# Public anon/publishable key (client-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-dev-anon-key>

# Service-role key (server only — NEVER expose to the client).
SUPABASE_SERVICE_ROLE_KEY=<your-dev-service-role-key>

# Postgres connection string for server-side scripts / migrations.
SUPABASE_DB_CONNECTION=postgresql://postgres:<password>@db.<your-dev-project-ref>.supabase.co:5432/postgres

# --- PartyKit (LOCAL dev only) ---
# Generate a fresh dev secret: openssl rand -hex 32
# This is a DEV-only secret for `partykit dev` and does NOT need to
# match production (production's PartyKit secret lives in Vercel /
# Cloudflare, untouched by local config).
PARTYKIT_SECRET=<generate-with-openssl-rand-hex-32>

# PartyKit host override (leave empty for the default local host).
NEXT_PUBLIC_PARTY_KIT_HOST=

# --- OpenRouter (AI-players batch pipeline) ---
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
