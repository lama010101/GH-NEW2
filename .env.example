# OpenRouter API key for the AI-players batch pipeline.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Supabase service-role Postgres connection string.
# The blueprint sets this from /run/repo_secrets/lama010101/GH-NEW2/.env.secrets,
# but you can override it here for local standalone script runs.
SUPABASE_DB_CONNECTION=
