{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "guess-history.com"
        }
      ],
      "destination": "https://www.guess-history.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/apply-ai-schedule-changes",
      "schedule": "* * * * *"
    }
  ]
}
