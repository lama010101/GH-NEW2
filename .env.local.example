# Guess-History local development environment template
# Copy to .env.local and fill in real values from your secret store.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PartyKit
PARTYKIT_SECRET=your-partykit-secret
NEXT_PUBLIC_PARTY_KIT_HOST=localhost:1999

# Web Push (VAPID) — required for push notifications.
# Generate a key pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be exposed to the browser and match VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:REPLACE_WITH_REAL_EMAIL@example.com
