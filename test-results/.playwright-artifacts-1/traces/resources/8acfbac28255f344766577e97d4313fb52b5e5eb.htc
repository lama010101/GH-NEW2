8:["$","$L9",null,{"locale":"en","now":"$D2026-06-28T13:53:46.402Z","timeZone":"Europe/Paris","messages":{"nav":{"notifications":"Notifications","profile":"Profile","home":"Home","friends":"Friends","leaderboard":"Leaderboard","profile_stats":"Profile & Stats","account":"Account","help":"Help","sign_out":"Sign Out","language":"Language","theme":"Theme","dark":"Dark","light":"Light","coming_soon":"{label} — coming soon!","close":"Close"},"help":{"title":"Help Center","hero_title":"How can we help?","hero_subtitle":"Find answers, learn the rules, and get the most out of Guess-History.","search_placeholder":"Search the help center…","search_label":"Search the help center","clear_search":"Clear search","go_back":"Go back","no_results":"No results. Try another search.","results_for":"Results for \"{q}\"","quick_start":"Quick Start","getting_started_walkthrough":"Getting Started Walkthrough","play_four_steps":"Play in Four Steps","game_modes":"Game Modes","browse_by_topic":"Browse by Topic","faq_title":"Frequently Asked Questions","keyboard_shortcuts":"Keyboard Shortcuts","troubleshooting":"Troubleshooting","still_need_help":"Still need help?","contact_text":"Cannot find what you are looking for? Reach out and we will get back to you shortly.","contact_support":"Contact Support","join_community":"Join Community","back_to_top":"Back to top","expand_section":"Expand section","collapse_section":"Collapse section","ql_gs_title":"Getting Started","ql_gs_blurb":"Learn the basics and start your first game in under a minute.","ql_steps_title":"How to Play","ql_steps_blurb":"Understand the map, year slider, hints, and submission flow.","ql_faq_title":"Scoring & XP","ql_faq_blurb":"See how location and time accuracy translate into points.","ql_mp_title":"Multiplayer","ql_mp_blurb":"Create a lobby, invite friends, and compete in real time.","gs_01_title":"Create your account","gs_01_desc":"Sign up with email or use a social login. Choose a display name and pick a historical figure as your avatar.","gs_02_title":"Play a Practice round","gs_02_desc":"Start with Practice mode to learn the ropes. No timer, unlimited retries—just explore and get comfortable.","gs_03_title":"Try the Daily Challenge","gs_03_desc":"Once ready, tackle the Daily Challenge. Same events as everyone else—see how you rank on the global leaderboard.","gs_04_title":"Invite friends","gs_04_desc":"Create a Compete lobby, copy the room code, and invite friends. Choose Rush for real-time action or Relax for turn-based play.","step_observe":"Observe","step_observe_blurb":"Study the historical image and any visible clues in the photo.","step_locate":"Locate","step_locate_blurb":"Drop a pin on the map where you believe the event took place.","step_date":"Date It","step_date_blurb":"Set the year using the slider or by typing directly.","step_submit":"Submit","step_submit_blurb":"Lock in your guess before the timer runs out (if enabled).","practice":"Practice","solo_warmup":"Solo warm-up","gm_practice_desc":"Hone your skills with unlimited practice games. No pressure, no timer required.","gm_practice_features":"Unlimited retries, No timer, Custom era filters, Instant feedback","daily_challenge":"Daily Challenge","same_events":"Same events for everyone","gm_daily_desc":"A new challenge every day. Same events for everyone. Climb the global leaderboard.","gm_daily_features":"24-hour window, Global leaderboard, One attempt per day, XP multiplier","level_up":"Level Up","progressive_runs":"Progressive runs","gm_levelup_desc":"Beat levels and earn XP to unlock harder challenges. A true test of skill.","gm_levelup_features":"Progressive difficulty, Unlockable content, Streak bonuses, Level-specific eras","compete":"Compete","play_with_friends":"Play with friends","gm_compete_desc":"Real-time Rush or turn-based Relax. Create a lobby, invite friends, compete.","gm_compete_features":"Rush (timed), Relax (async), Up to 8 players, Room codes","cat_placing":"Placing Your Guess","cat_placing_desc":"Click anywhere on the world map to drop a pin. You can zoom, pan, and search for locations. The closer your pin is to the actual event location, the higher your score. You can move the pin as many times as you want before submitting.","cat_year":"Choosing the Year","cat_year_desc":"Use the year slider or type directly to pick when you think the event occurred. The year range is customizable per game (default is from 400 BC to the current year). The smaller the gap between your guess and the actual year, the more points you earn.","cat_hints":"Using Hints","cat_hints_desc":"Each round offers hints organized in five tiers. Hint types include Century, Historical Event, Decade, Contemporary Event, Visual Clues, Continent, Remote Landmark, Region, and Nearby Landmark. Hints are independently purchasable—no prerequisites required. Each hint costs accuracy and XP penalty. Use them wisely.","cat_badges":"Badges & Rewards","cat_badges_desc":"Earn Gold (100%), Silver (95–99%), or Bronze (90–94%) badges for Year accuracy, Location accuracy, or a balanced Combo score. Near-misses (88–89%) are shown when you just miss a badge. Badges are for instant feedback; your stats and XP are what persist.","cat_account":"Account & Settings","cat_account_desc":"Set your display name and choose a historical figure as your avatar. View your overall accuracy, total XP, member since date, and manage your account details from the Account page.","cat_notifications":"Notifications","cat_notifications_desc":"Get notified when a friend invites you to a game. Tap the bell icon on the top bar to view recent activity.","cat_read_more":"Read more","faq_q1":"How is my score calculated?","faq_a1":"Each round gives you up to 200 XP: 100 for location accuracy and 100 for year accuracy. Location score decays with distance from the actual place (max 20,000 km). Year score decays with the difference from the actual year (max 200 years). Hint penalties are subtracted after the round.","faq_q2":"Can I play without an account?","faq_a2":"You can browse the home page, but you need an account to play games, save progress, earn XP, and compete against friends. Signing up is free and only takes a moment.","faq_q3":"What are the different game modes?","faq_a3":"Practice is a solo warm-up with unlimited retries. Daily Challenge offers the same events for everyone every 24 hours with a global leaderboard. Level Up is a progressive run where you beat levels to unlock harder challenges. Compete lets you face friends in real-time Rush or turn-based Relax matches.","faq_q4":"How do hints work?","faq_a4":"Hints are purchased per round using accuracy debt. Each hint reveals information like nearby landmarks, country, century clues, or distances. Hints are organized in five tiers and are independently purchasable—no prerequisites. The total hint debt is subtracted from your round score.","faq_q5":"How do multiplayer games work?","faq_a5":"In Compete mode, create a lobby and invite friends via a 6-character room code. You can play synchronous Rush (timed, all players guess together) or asynchronous Relax (take turns at your own pace). Games support up to 8 players with host-controlled settings.","faq_q6":"Can I zoom into the image?","faq_a6":"Yes, the historical image can be zoomed. Use pinch-to-zoom on mobile, scroll-wheel zoom on desktop, or tap the zoom controls. You can also open a fullscreen viewer with pan and zoom. Study the photo carefully—look for architecture, clothing, vegetation, landmarks, and any visible text or flags.","faq_q7":"What happens if the timer runs out?","faq_a7":"In Rush mode, if you do not submit before the timer expires, your guess is automatically submitted at the current pin location and selected year. In Relax mode, there is no timer—take your time.","faq_q8":"Why did not my invite arrive?","faq_a8":"Make sure your friend has an account and is logged in. Invites appear in the notification bell. If they still do not see it, try refreshing the page or sending the room code directly via chat.","faq_q9":"How do I earn badges?","faq_a9":"Badges are awarded based on accuracy per round: Gold (100%), Silver (95–99%), Bronze (90–94%). You can earn Year badges, Location badges, or Combo badges when both scores are high. Near-misses at 88–89% are also shown.","kb_esc_action":"Close modals / Cancel","ts_t1_problem":"Game is not loading or stuck on black screen","ts_t1_solution":"Try refreshing the page. If the issue persists, clear your browser cache and cookies, then reload. Ensure you are using a modern browser (Chrome, Firefox, Safari, Edge).","ts_t2_problem":"My friend did not receive the invite","ts_t2_solution":"Make sure your friend is logged in. Invites appear in the notification bell at the top right. As a fallback, copy the 6-character room code and share it directly via any messaging app.","ts_t3_problem":"Timer ran out before I could submit","ts_t3_solution":"In Rush mode, guesses are auto-submitted when time expires. If you need more time, ask the host to disable the timer or switch to Relax mode which has no time limit.","ts_t4_problem":"Hints are not showing any information","ts_t4_solution":"Hints must be purchased before they reveal content. Click the hint button, confirm the purchase, and the information will appear. Each hint reduces your final score.","ts_t5_problem":"Score seems lower than expected","ts_t5_solution":"Check if you used hints—they apply penalties to both accuracy and XP. Also verify your distance from the actual location and year difference. The max per round is 200 XP (100 location + 100 year)."},"home":{"logo_guess":"GUESS-","logo_his":"HIS","logo_tory":"TORY","daily_name":"DAILY","daily_subtitle":"DAILY COMPETITION","practice_name":"PRACTICE","practice_subtitle":"SOLO WARM-UP","levelup_name":"LEVEL UP","levelup_subtitle":"PROGRESSIVE RUNS","compete_name":"CHALLENGE","compete_subtitle":"CHALLENGE FRIENDS","daily_cta":"Play Today's Challenge","daily_results_cta":"View Today's Results","daily_reset":"Today's challenge resets in {hours}h {minutes}m","practice_start":"Start Practice","practice_timer_label":"Round Timer","practice_year_range_label":"Year Range","levelup_start":"Start Level {level}","levelup_min_accuracy":"Min accuracy to pass: {pct}%","compete_create":"Create lobby","compete_join":"Join with code","compete_go":"Go to Lobby","compete_code_placeholder":"Enter code","compete_tab_invitations":"INVITATIONS","compete_tab_your_turn":"YOUR TURN","compete_tab_completed":"COMPLETED","compete_loading_invites":"Looking for invitations…","compete_no_invitations":"No pending invitations","compete_no_your_turn":"No games waiting for your turn","compete_no_completed":"No completed games yet","compete_invited_you":"Invited you to a game","compete_invite_meta":"{mode} · sent {time}","compete_invite_sent":"sent {time}","compete_round_label":"Round {current} / {total}","compete_play":"PLAY","compete_mode_rush":"Rush","compete_mode_relax":"Relax","compete_completed":"Completed","compete_join_game":"JOIN GAME","compete_create_game":"CREATE GAME","tagline":"Where and when did it happen?","daily_new_challenge":"New challenge in","compete_desc":"Play against your friends.\nReal-Time: Up to 5 mins\nTurn-Based: Up to 14 days","daily_desc":"A new challenge every day.\nSame events for everyone.\nClimb the leaderboard.","levelup_desc":"Beat levels and earn XP.\nProgressive difficulty from 1 to 100.\nUnlock new challenges.","practice_desc":"Hone your skills solo.\nCustom timer and year range.\nUnlimited practice games."},"common":{"next_round":"Next Round","submit":"Submit","play_again":"Play Again","home":"Home","accuracy":"ACCURACY","experience":"EXPERIENCE","where":"WHERE","when":"WHEN","correct":"Correct","your_guess":"Your guess","years_off":"{n} years off","km_away":"{n} km away","round_label":"Round {current} / {total}","loading":"Loading...","no_description":"No description available"},"lobby":{"waiting":"Waiting for players ({ready}/{total} ready)","ready":"Ready","not_ready":"Not Ready","start_game":"Start Game","room_code":"Room code","copy_link":"Copy link","kick":"Kick","round_timer":"Round Timer","year_range":"Year Range","results_timer":"Results Timer","invite_friends":"Invite Friends","invite":"Invite","host":"Host","you":"You","connected":"Connected","disconnected":"Disconnected","mode_challenge":"CHALLENGE","game_lobby":"Game Lobby","invite_players":"Invite Players","copy_code":"Copy Code","link_copied":"Link copied!","code_copied":"Code copied!","search_players":"Search players...","no_players_found":"No players found","view_all":"View all ({count})","all_players":"All Players ({count})","players":"Players ({current}/{total})","ready_count":"{count} ready","kick_player":"Kick player","remove_invite":"Remove invite","invited":"INVITED","no_players_yet":"No players yet","game_settings":"Game Settings","realtime":"Real-Time","turn_by_turn":"Turn-Based","max_time_per_turn":"Max Time Per Turn","1_day":"1 day","n_days":"{n} days","ready_waiting":"Ready — waiting for others","im_ready":"I'm ready","players_ready":"({ready}/{total} players ready)","select_all":"Select all","deselect_all":"Deselect all"},"compete_page":{"create_game":"Create Game","join_game":"Join Game","creating":"Creating…","joining":"Joining…","room_code_label":"Room Code","err_identity":"Identity not ready — please wait","err_code_required":"Room code is required","err_create":"Failed to create game","err_join":"Failed to join game","failed_lobby":"Failed to create lobby","failed_lobby_retry":"Failed to create lobby, try again"},"game":{"sound":"Sound","vibrate":"Vibrate","settings":"Settings","submit":"Submit","hint_select_both":"Select {where} and {when} first","and":"and","establishing_identity":"Establishing identity…","identity_error":"Identity error","game_id":"Game ID","joining_room":"Joining room…","next_round":"Next Round","play_again":"Play Again","where":"WHERE","when":"WHEN","accuracy":"ACCURACY","all_rounds":"All Rounds","auto_advancing_i